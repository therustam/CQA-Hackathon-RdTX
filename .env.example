# Claude API key (https://console.anthropic.com). Required for evaluation only;
# import, browsing, appeals and the checklist editor work without it.
ANTHROPIC_API_KEY=

# Model and effort used for evaluation.
CQA_MODEL=claude-opus-5-5
CQA_EFFORT=medium

# Organizers' GET endpoint WITHOUT the group_id parameter (copy the "Открыть GET для DEV"
# link from the guide, page 3, and drop "&group_id=DEV"). group_id is entered in the UI.
CQA_SOURCE_URL=

# SQLite file (created on first start).
CQA_DB=cqa.db
