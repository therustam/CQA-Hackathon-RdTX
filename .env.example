# Set either key (or both; OpenAI takes precedence). Required for evaluation only;
# import, browsing, appeals and the checklist editor work without a model key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model override. Defaults to gpt-4o-mini for OpenAI and claude-opus-5-5 for Anthropic.
CQA_MODEL=
CQA_EFFORT=medium

# Organizers' GET endpoint WITHOUT the group_id parameter (copy the "Открыть GET для DEV"
# link from the guide, page 3, and drop "&group_id=DEV"). group_id is entered in the UI.
CQA_SOURCE_URL=

# SQLite file (created on first start).
CQA_DB=cqa.db
