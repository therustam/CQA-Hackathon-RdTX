    {
      "name": "Vitals Strip",
      "kind": "custom",
      "refersTo": "vitals-strip",
      "description": "Flat Chart Green band with identifier, total, section bars and the gross-error flag chip.",
      "html": "<header class=\"ds-vitals\"><div><h1>p1-ru-022</h1><div class=\"ds-meta\"><b>Чат</b> Язык <b>RU</b></div></div><div class=\"ds-score\">Итог<div class=\"ds-total\">85<small>/ 100</small></div></div><div class=\"ds-cells\"><div>Начало и понимание запроса <b>100%</b><i><u style=\"width:100%\"></u></i></div><div>Грубые нарушения <span class=\"ds-flag\">выявлено m11</span></div></div></header>",
      "css": ".ds-vitals{--cqa-green:#12392b;--cqa-green-2:#1d553f;--cqa-green-ink:#e9f3ea;--cqa-green-ink-2:#b9d3c1;--cqa-signal:#a6e07b;--cqa-ink:#17201b;--cqa-ink-2:#46524b;--cqa-ink-3:#6a756f;--cqa-paper:#fff;--cqa-paper-2:#f3f6f2;--cqa-rule:#d5dcd4;--cqa-rule-strong:#aab6ad;--cqa-yes:#17673b;--cqa-yes-bg:#e2f2e3;--cqa-no:#a8231b;--cqa-no-bg:#fbe6e3;--cqa-na:#56625b;--cqa-na-bg:#e9ede9;--cqa-amber:#7a4f00;--cqa-amber-bg:#fff0cf;--cqa-alert:#b3261e;--cqa-hl:#f1f8c8;--cqa-hl-rule:#8fb93a;--cqa-focus:#2f7a52;font-family:'Golos Text','Segoe UI',system-ui,sans-serif;font-variant-numeric:tabular-nums;background:var(--cqa-green);color:var(--cqa-green-ink);padding:18px 28px 20px;display:grid;grid-template-columns:1fr auto;gap:8px 40px;align-items:end;}.ds-vitals h1{margin:0;font-size:34px;letter-spacing:-0.02em;color:#fff;}.ds-meta{color:var(--cqa-green-ink-2);display:flex;gap:18px;}.ds-meta b{color:var(--cqa-green-ink);}.ds-score{text-align:right;font-size:14px;color:var(--cqa-green-ink-2);}.ds-total{font-size:64px;font-weight:700;line-height:1;letter-spacing:-0.03em;color:#fff;}.ds-total small{font-size:22px;font-weight:400;color:var(--cqa-green-ink-2);letter-spacing:0;}.ds-cells{grid-column:1/-1;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:4px 24px;padding-top:12px;border-top:1px solid var(--cqa-green-2);font-size:14px;color:var(--cqa-green-ink-2);}.ds-cells b{color:#fff;}.ds-cells i{display:block;height:6px;background:var(--cqa-green-2);border-radius:3px;overflow:hidden;margin-top:4px;}.ds-cells u{display:block;height:100%;background:var(--cqa-signal);}.ds-flag{display:inline-block;background:var(--cqa-alert);color:#fff;font-weight:700;border-radius:4px;padding:2px 10px;}"
